generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int       @id @default(autoincrement())
  email         String    @unique
  password      String
  name          String?
  botToken      String?
  telegramId    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  groups        Group[]
  images        Image[]
  sendJobs      SendJob[]
}

model Group {
  id          Int      @id @default(autoincrement())
  userId      Int
  chatId      String
  title       String
  type        String   @default("group")
  isActive    Boolean  @default(true)
  testStatus  String?
  testMessage String?
  lastUsedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])
  sendRecords SendRecord[]
}

model Image {
  id            Int      @id @default(autoincrement())
  userId        Int
  fileName      String
  filePath      String
  fileSize      Int
  mimeType      String
  thumbnailPath String?
  width         Int?
  height        Int?
  status        String   @default("pending")
  caption       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id])
  sendRecords   SendRecord[]
}

model SendJob {
  id             Int           @id @default(autoincrement())
  userId         Int
  status         String        @default("pending")
  totalSends     Int           @default(0)
  completedSends Int           @default(0)
  failedSends    Int           @default(0)
  delayMs        Int           @default(1000)
  sendAsAlbum    Boolean       @default(false)
  albumSize      Int           @default(10)
  caption        String?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  user           User          @relation(fields: [userId], references: [id])
  records        SendRecord[]
}

model SendRecord {
  id            Int      @id @default(autoincrement())
  jobId         Int
  groupId       Int
  imageId       Int
  telegramMsgId String?
  status        String   @default("pending")
  errorMessage  String?
  retryCount    Int      @default(0)
  sentAt        DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  job           SendJob  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  group         Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  image         Image    @relation(fields: [imageId], references: [id], onDelete: Cascade)
}
